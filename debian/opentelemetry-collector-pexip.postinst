#!/bin/sh

set -e

if [ "$1" = "configure" ] || [ "$1" = "reconfigure" ] ; then
        # Create otelcol-pexip user and group
        if ! getent passwd otelcol-pexip >/dev/null; then
                adduser --system \
                --group \
                --home /var/lib/otelcol-pexip \
                --no-create-home \
                --gecos "Opentelemetry collector Pexip user" \
                --disabled-login \
                otelcol-pexip
        fi

	if [ ! -e /etc/otelcol-pexip ]; then
		install -d -m0700 -o otelcol-pexip -g otelcol-pexip /etc/otelcol-pexip
	fi
fi

#DEBHELPER#

exit 0
